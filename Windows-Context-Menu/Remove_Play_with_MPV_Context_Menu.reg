Windows Registry Editor Version 5.00

; =======================================================================================================
; Project     : biraj-mpv-conf
; Repository  : https://github.com/Biraj2004/biraj-mpv-conf
; Developer   : Biraj Sarkar (@Biraj2004)
; License     : Apache-2.0
; Description : Removes "Play with MPV as a Playlist" from the Windows File Explorer context menu.
; =======================================================================================================

[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\Folder\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\Drive\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\video\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\audio\shell\PlayWithMPV]

; Video extension specific entries
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mkv\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mp4\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.avi\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.webm\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mov\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.ts\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.m2ts\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.flv\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.wmv\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.m4v\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.3gp\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.ogv\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.vob\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.dav\shell\PlayWithMPV]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.y4m\shell\PlayWithMPV]
