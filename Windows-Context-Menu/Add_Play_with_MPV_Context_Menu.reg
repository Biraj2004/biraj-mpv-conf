Windows Registry Editor Version 5.00

; =======================================================================================================
; Project     : biraj-mpv-conf
; Repository  : https://github.com/Biraj2004/biraj-mpv-conf
; Developer   : Biraj Sarkar (@Biraj2004)
; License     : Apache-2.0
; Description : Adds "Play with MPV as a Playlist" to the Windows File Explorer context menu.
;
; Pure Native MPV Architecture:
; - Directly invokes official standard mpv.exe (C:\Program Files\mpv\mpv.exe) with 0 external binaries.
; - Single-Instance forwarding is handled seamlessly via internal lock-synchronized IPC.
; - Standard "Open" / Double-Click: Retains normal independent multi-window behavior.
; =======================================================================================================

; -------------------------------------------------------------------------------------------------------
; 1. Single Folder & Folder Shortcuts in Windows File Explorer
; -------------------------------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\PlayWithMPV]
@="Play with MPV as a Playlist"
"Icon"="\"C:\\Program Files\\mpv\\mpv.exe\",0"
"AppliesTo"="System.ItemCount:1"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\PlayWithMPV\command]
@="\"C:\\Program Files\\mpv\\mpv.exe\" --script-opts-append=single_instance-enabled=yes \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Folder\shell\PlayWithMPV]
@="Play with MPV as a Playlist"
"Icon"="\"C:\\Program Files\\mpv\\mpv.exe\",0"
"AppliesTo"="System.ItemCount:1"

[HKEY_CURRENT_USER\Software\Classes\Folder\shell\PlayWithMPV\command]
@="\"C:\\Program Files\\mpv\\mpv.exe\" --script-opts-append=single_instance-enabled=yes \"%1\""

; -------------------------------------------------------------------------------------------------------
; 2. Folder Background (Empty space inside an open folder)
; -------------------------------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\PlayWithMPV]
@="Play with MPV as a Playlist"
"Icon"="\"C:\\Program Files\\mpv\\mpv.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\PlayWithMPV\command]
@="\"C:\\Program Files\\mpv\\mpv.exe\" --script-opts-append=single_instance-enabled=yes \"%V\""

; -------------------------------------------------------------------------------------------------------
; 3. Drive / USB Partition (Single Drive only)
; -------------------------------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Software\Classes\Drive\shell\PlayWithMPV]
@="Play with MPV as a Playlist"
"Icon"="\"C:\\Program Files\\mpv\\mpv.exe\",0"
"AppliesTo"="System.ItemCount:1"

[HKEY_CURRENT_USER\Software\Classes\Drive\shell\PlayWithMPV\command]
@="\"C:\\Program Files\\mpv\\mpv.exe\" --script-opts-append=single_instance-enabled=yes \"%1\""

; -------------------------------------------------------------------------------------------------------
; 4. Universal Video PerceivedType
; -------------------------------------------------------------------------------------------------------
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\video\shell\PlayWithMPV]
@="Play with MPV as a Playlist"
"Icon"="\"C:\\Program Files\\mpv\\mpv.exe\",0"
"MultiSelectModel"="Player"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\video\shell\PlayWithMPV\command]
@="\"C:\\Program Files\\mpv\\mpv.exe\" --script-opts-append=single_instance-enabled=yes \"%1\""

; -------------------------------------------------------------------------------------------------------
; 5. Specific Video File Extensions (Direct Association for Reliable Multi-Select on Desktop/Explorer)
; -------------------------------------------------------------------------------------------------------

