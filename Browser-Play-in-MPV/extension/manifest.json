{
  "manifest_version": 3,
  "name": "Play in MPV",
  "version": "1.0.3",
  "description": "Open any link, YouTube video, or Stremio stream in your local MPV media player. Seamlessly hand off playback with zero manual copying.",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Play in MPV"
  },

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js":  ["content_scripts/youtube.js"],
      "css": ["styles/youtube_button.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://web.stremio.com/*",
        "*://app.strem.io/*"
      ],
      "js":  ["content_scripts/stremio_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://web.stremio.com/*",
        "*://app.strem.io/*"
      ],
      "js":  ["content_scripts/stremio.js"],
      "css": ["styles/stremio.css"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://web.stremio.com/*",
    "*://app.strem.io/*"
  ]
}
