@echo off
setlocal EnableDelayedExpansion
title Stremio Setup To Play In MPV - by Biraj2004
cd /d "%~dp0"

:: =======================================================================================================
:: GitHub      : https://github.com/Biraj2004
:: Developer   : Biraj
:: Description : Configures Stremio to add MPV player integration ("Play in MPV").
::                - Automatically locates MPV (mpv.exe / mpvnet.exe) across PATH, Scoop, and standard paths.
::                - Detects active Stremio processes to prevent locked file conflicts during patching.
::                - Injects the MPV configuration and robust launch handler into Stremio's server.js.
::                - Automatically creates timestamped backups (.backup_YYYYMMDD_HHMMSS) before modifying.
::                - Re-running this script is SAFE: existing up-to-date configurations are skipped.
:: =======================================================================================================

echo =======================================================================================================
echo                                  STREMIO SETUP TO PLAY IN MPV
echo                       Developed by : Biraj
echo                       GitHub       : https://github.com/Biraj2004
echo =======================================================================================================
echo.
echo [INFO] Working Folder   : %CD%
echo [INFO] Target           : Stremio server.js (External Player Configuration)
echo [INFO] Action           : Add "Play in MPV" option next to "Play in VLC" in player menu
echo [INFO] Scope            : Local Stremio installation(s)
echo [INFO] Safety           : Full timestamped backup (.backup_*) created before modifying files
echo.
echo =======================================================================================================
echo  WARNING: This will configure Stremio to add MPV as an external player option.
echo =======================================================================================================
echo.
set "CONFIRM="
set /p CONFIRM=Type Y and press Enter to proceed, or N to cancel : 

if /i "%CONFIRM%"=="Y" goto :PROCEED
if /i "%CONFIRM%"=="YES" goto :PROCEED

echo.
echo [CANCELLED] Setup execution cancelled. No files or settings were modified. Exiting safely.
echo.
pause
endlocal
exit /b 0

:PROCEED
echo.
echo [PROCESSING] Checking system prerequisites and locating MPV...
echo =======================================================================================================

REM ----------------------------------------------------------------
REM  Helper vars (must be set OUTSIDE any parenthesized block -
REM  "ProgramFiles(x86)" contains a ")" which breaks cmd's block
REM  parser if used directly inside an if/for block).
REM ----------------------------------------------------------------
set "PF=%ProgramFiles%"
set "PF86=%ProgramFiles(x86)%"
set "LAD=%LocalAppData%"
set "UP=%UserProfile%"

REM ================================================================
REM  STEP 1: Locate mpv on this system
REM ================================================================
set "MPV_PATH="

REM 1a. Allow passing a path manually, e.g.:
REM     Win_Setup_Stremio_To_Play_In_MPV.bat "D:\Apps\mpv\mpv.exe"
if not "%~1"=="" if exist "%~1" set "MPV_PATH=%~1"

REM 1b. Check the system PATH
if not defined MPV_PATH (
    where mpv.exe >nul 2>&1
    if not errorlevel 1 for /f "delims=" %%P in ('where mpv.exe') do if not defined MPV_PATH set "MPV_PATH=%%P"
)
if not defined MPV_PATH (
    where mpvnet.exe >nul 2>&1
    if not errorlevel 1 for /f "delims=" %%P in ('where mpvnet.exe') do if not defined MPV_PATH set "MPV_PATH=%%P"
)

REM 1c. Check common install locations
if not defined MPV_PATH if exist "%PF%\mpv\mpv.exe" set "MPV_PATH=%PF%\mpv\mpv.exe"
if not defined MPV_PATH if exist "%PF86%\mpv\mpv.exe" set "MPV_PATH=%PF86%\mpv\mpv.exe"
if not defined MPV_PATH if exist "%PF%\mpv.net\mpvnet.exe" set "MPV_PATH=%PF%\mpv.net\mpvnet.exe"
if not defined MPV_PATH if exist "%PF86%\mpv.net\mpvnet.exe" set "MPV_PATH=%PF86%\mpv.net\mpvnet.exe"
if not defined MPV_PATH if exist "%LAD%\Programs\mpv\mpv.exe" set "MPV_PATH=%LAD%\Programs\mpv\mpv.exe"
if not defined MPV_PATH if exist "%LAD%\mpv\mpv.exe" set "MPV_PATH=%LAD%\mpv\mpv.exe"
if not defined MPV_PATH if exist "%UP%\scoop\apps\mpv\current\mpv.exe" set "MPV_PATH=%UP%\scoop\apps\mpv\current\mpv.exe"
if not defined MPV_PATH if exist "C:\mpv\mpv.exe" set "MPV_PATH=C:\mpv\mpv.exe"

REM ================================================================
REM  STEP 2: Stop here if mpv isn't installed - do NOT touch Stremio
REM ================================================================
if not defined MPV_PATH (
    echo [ERROR] MPV was NOT found on this system.
    echo.
    echo         This script will NOT modify Stremio until mpv is installed.
    echo.
    echo         Recommended setup ^(gpu-next / libplacebo / d3d11va / Vulkan^):
    echo.
    echo         1. Download the mpv-winbuild ^(by zhongfly^) Windows build:
    echo              https://github.com/zhongfly/mpv-winbuild/releases
    echo            Grab the latest "mpv-x86_64-*.7z" asset.
    echo         2. Extract it to:   C:\mpv\
    echo            ^(so that C:\mpv\mpv.exe exists^)
    echo         3. ^(Recommended^) Apply the full tuned config suite - open
    echo            PowerShell and run:
    echo              $temp = "$env:TEMP\biraj-mpv-conf"
    echo              git clone --depth 1 https://github.com/Biraj2004/biraj-mpv-conf.git $temp
    echo              New-Item -ItemType Directory -Force -Path "$env:APPDATA\mpv"
    echo              Copy-Item "$temp\mpv.conf","$temp\input.conf","$temp\menu.conf" -Destination "$env:APPDATA\mpv\" -Force
    echo              Copy-Item "$temp\fonts","$temp\scripts","$temp\script-opts" -Destination "$env:APPDATA\mpv\" -Recurse -Force
    echo              Remove-Item -Recurse -Force $temp
    echo            ^(Full guide: https://github.com/Biraj2004/biraj-mpv-conf^)
    echo         4. Run this script again.
    echo.
    echo         Already have mpv somewhere else? Run this script again as:
    echo             Win_Setup_Stremio_To_Play_In_MPV.bat "C:\your\path\to\mpv.exe"
    echo.
    pause
    endlocal
    exit /b 1
)

echo [INFO] MPV Executable   : %MPV_PATH%
echo.

REM ================================================================
REM  STEP 3: Warn if Stremio is running (file could be locked)
REM ================================================================
tasklist /FI "IMAGENAME eq Stremio.exe" 2>nul | find /I "Stremio.exe" >nul
if not errorlevel 1 (
    echo =======================================================================================================
    echo  WARNING: Stremio is currently running.
    echo  Close it fully ^(including the system tray icon^) before continuing,
    echo  otherwise the file may be locked or changes may get overwritten when Stremio exits.
    echo =======================================================================================================
    echo.
    set "STREMIO_CONFIRM="
    set /p STREMIO_CONFIRM=Type Y to continue anyway, or N to cancel : 
    if /i not "!STREMIO_CONFIRM!"=="Y" if /i not "!STREMIO_CONFIRM!"=="YES" (
        echo.
        echo [CANCELLED] Setup cancelled to prevent file lock conflict. Exiting safely.
        echo.
        pause
        endlocal
        exit /b 0
    )
    echo.
)

REM ================================================================
REM  STEP 4: Launch PowerShell Engine to patch server.js
REM ================================================================
where powershell >nul 2>&1
if errorlevel 1 (
    echo [ERROR] PowerShell was not found on this system. Cannot continue.
    echo.
    pause
    endlocal
    exit /b 1
)

powershell -NoProfile -NoLogo -ExecutionPolicy Bypass -EncodedCommand "" 
set "PS_EXIT=!ERRORLEVEL!"

echo.
if "!PS_EXIT!"=="0" (
    echo -------------------------------------------------------------------------------------------------------
    echo =======================================================================================================
    echo [SUCCESS] Stremio MPV setup completed successfully.
    echo           Restart Stremio - "Play in MPV" should now appear next to "Play in VLC".
    echo =======================================================================================================
) else (
    echo -------------------------------------------------------------------------------------------------------
    echo =======================================================================================================
    echo [ERROR] Setup did not complete successfully. See messages above.
    echo =======================================================================================================
)

echo -------------------------------------------------------------------------------------------------------
echo =======================================================================================================
echo [FINISHED] Script execution finished. GitHub: https://github.com/Biraj2004
echo =======================================================================================================
echo.
pause
endlocal
exit /b !PS_EXIT!
